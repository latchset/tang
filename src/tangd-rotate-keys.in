SUMMARY="Perform rotation of tang keys"

usage() {
    _ret="${1:-1}"
    exec >&2
    echo "Usage: ${0} [-h] [-v] -d <KEYDIR>"
    echo
    echo "${SUMMARY}"
    echo
    echo "  -d KEYDIR  The directory with the keys, e.g. /var/db/tang"
    echo
    echo "  -h         Display this usage information"
    echo
    echo "  -v         Verbose. Display additional info on keys created/rotated"
    echo
    exit "${_ret}"
}

log() {
    _msg="${1}"
    _verbose="${2:-}"
    [ -z "${_verbose}" ] && return 0
    echo "${_msg}" >&2
}

error() {
    log "${1}" 1
    usage 1
}

set_perms() {
    chmod -- 0440 "${1}"
    if ! chown -- @user@:@group@ "${1}" 2>/dev/null; then
        echo "Unable to change owner/group for ${1} to @user@:@group@" >&2
    fi
}

# Shared helpers (e.g. algorithm support detection) live next to this
# script, both in the build tree and when installed.
. "$(dirname -- "$0")/tangd-utils.sh"

JWKDIR=
VERBOSE=
while getopts "hvd:" o; do
    case "${o}" in
        d) JWKDIR="${OPTARG}";;
        h) usage 0;;
        v) VERBOSE=1;;
        *) usage 1;;
    esac
done

[ -z "${JWKDIR}" ] && error "Please specify the keys directory with -d switch"
[ -r "${JWKDIR}" ] || error "Error trying to access JWK directory '${JWKDIR}'"

cd "${JWKDIR}" || error "Unable to change to keys directory '${JWKDIR}'"
    # Stage the new key set in a temporary directory inside the keys
    # directory: the final moves are same-filesystem renames, and any
    # failure below leaves the current, still-advertised keys untouched,
    # so tangd keeps serving /adv throughout.
    #
    # The staging directory must be anchored to the absolute location of
    # the keys directory: JWKDIR may be relative, and the working
    # directory changes again (cd -) before the EXIT trap fires, so a
    # relative path would both duplicate the directory at creation and
    # point somewhere else at cleanup. mktemp also avoids the
    # predictable PID-based name.
    STAGE="$(mktemp -d "$(pwd)/.tang-rotate.XXXXXX")" \
        || error "Unable to create staging directory"
    trap 'rm -rf -- "${STAGE}"' EXIT
    chmod 0700 "${STAGE}"

    # Remember which keys are currently advertised: only these will be
    # hidden once the new set is in place.
    old_list="${STAGE}/old"
    find . -maxdepth 1 -type f -name '*.jwk' ! -name '.*' | sort > "${old_list}"

    DEFAULT_THP_HASH="S256"

    # Set default umask for file creation.
    umask 0337

    # Generate a key for the given algorithm into the staging directory.
    # A generation failure is fatal: jose's own error is printed and the
    # rotation aborts with the old keys still in place.
    new_key() {
        _alg="${1}"
        _json="$(printf '{"alg": "%s"}' "${_alg}")"
        if ! _jwe="$(jose jwk gen --input "${_json}")"; then
            echo "Error generating ${_alg} key" >&2
            exit 1
        fi
        _thp="$(printf '%s' "${_jwe}" | jose jwk thp --input=- \
                                           -a "${DEFAULT_THP_HASH}")"
        echo "${_jwe}" > "${STAGE}/${_thp}.jwk"
        set_perms "${STAGE}/${_thp}.jwk"
        log "Created new key ${_thp}.jwk (${_alg})" "${VERBOSE}"
    }

    # Create a new set of keys.
    for alg in "ES512" "ECMR"; do
        new_key "${alg}"
    done

    # Hybrid exchange keys: post-quantum ML-KEM keys pairing with the
    # classical ECMR key. The previous ML-KEM keys are among the old keys
    # recorded above, so they are always recreated here; algorithms not
    # supported by jose are skipped, while a generation failure for a
    # supported algorithm aborts the rotation.
    for alg in ML-KEM-512 ML-KEM-768 ML-KEM-1024; do
        if ! alg_supported "${alg}"; then
            echo "Skipping ${alg} key generation (not supported by jose)" >&2
            continue
        fi
        new_key "${alg}"
    done

    # Introduce the new keys before hiding the old ones, so that at no
    # point is the daemon left without an advertised, usable key set;
    # while both sets are visible, the advertisement merely lists more
    # keys, which is harmless.
    for staged in "${STAGE}"/*.jwk; do
        [ -f "${staged}" ] || continue
        mv -f -- "${staged}" .
    done

    # Disable advertisement of the old keys. They remain on disk,
    # dot-prefixed, so clients bound to them keep working. Hidden keys
    # are never pruned automatically: they accumulate with every
    # rotation and must be removed manually once no client depends on
    # them anymore.
    while read -r old; do
        [ -n "${old}" ] || continue
        mv -f -- "${old}" "./.${old#./}"
        log "Disabled advertisement of key ${old#./} -> .${old#./}" "${VERBOSE}"
    done < "${old_list}"
cd - >/dev/null

log "Keys rotated successfully" "${VERBOSE}"
