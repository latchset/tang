fetch() {
    curl -sfg "http://127.0.0.1:${PORT}${1}"
}

ver() {
    jose jws ver -i- -k "${1}"
}

random_port() {
    if [ -n "${TANG_BSD}" ]; then
        jot -r 1 1024 65536
    else
        if test -f /dev/urandom;
        then
            shuf -i 1024-65535 -n 1 --random-file=/dev/urandom
        else
            shuf -i 1024-65535 -n 1
        fi
    fi
}

check_if_port_listening() {
    if [ -n "${TANG_BSD}" ]; then
        sockstat -l|grep "[\:\.]${1}" >/dev/null 2>&1
    else

        ss -anl|grep "[\:\.]${1}"|grep LISTEN >/dev/null 2>&1
    fi
}

wait_for_port()
{
    local port="${1}"
    sleep 1

    local i=0
    while [ "${i}" -lt 90 ]; do
        check_if_port_listening "${port}" && return 0
        i=$((i + 1))
        echo "try ${i}: waiting for port" >&2
        sleep 1
    done
    return 1
}

start_server() {
    "${SOCAT}" TCP-LISTEN:"${1}",bind=127.0.0.1,fork SYSTEM:"${VALGRIND} tangd ${TMP}/db" &
}

start_server_endpoint() {
    "${SOCAT}" TCP-LISTEN:"${1}",bind=127.0.0.1,fork SYSTEM:"${VALGRIND} tangd ${TMP}/db -e ${ENDPOINT}" &
}

start_standalone_server() {
    ${VALGRIND} tangd -p ${1} -l ${TMP}/db &
}

start_standalone_server_fg() {
    ${VALGRIND} tangd -p ${1} -l ${TMP}/db
}

start_standalone_server_endpoint() {
    ${VALGRIND} tangd -p ${1} -l ${TMP}/db -e ${2} &
}

on_exit() {
    if [ "${PID}" ]; then
        kill "${PID}" || true
        wait "${PID}" || true
    fi
    [ -d "${TMP}" ] && rm -rf "${TMP}"
}

validate() {
    if ! _jwks="$(jose fmt --json="${1}" -Og payload -SyOg keys \
                 -AUo- 2>/dev/null)"; then
        echo "Advertisement is malformed" >&2
        exit 1
    fi
    _ver="$(printf '%s' "${_jwks}" | jose jwk use -i- -r -u verify -o-)"
    if ! printf '%s' "${_ver}" | jose jws ver -i "${1}" -k- -a; then
        echo "Advertisement is missing signatures" >&2
        exit 1
    fi
}

validate_sig() {
    jose fmt --json "${1}" --output=- | jose jwk use --input=- --required \
        --use verify 2>/dev/null
}

validate_exc() {
    jose fmt --json "${1}" --output=- | jose jwk use --input=- --required \
        --use deriveKey 2>/dev/null
}

sanity_check() {
    # Skip test if socat is not available.
    [ -n "${SOCAT}" ] || exit 77
}

die() {
    echo "${1}" >&2
    exit 1
}

valid_key_perm() {
    if [ -n "${TANG_BSD}" ]; then
        _perm="$(stat -f %Lp "${1}")"
    else
        _perm="$(stat -c %a "${1}")"
    fi
    [ "${_perm}" = "440" ]
}

expected_fail () {
    echo "Test was expected to fail" >&2
    exit 1
}

# ML-KEM variants need a runtime probe: jose registers algorithms even
# when the runtime crypto policy (e.g. FIPS) blocks generating keys for
# them, and tangd-keygen/tangd-rotate-keys skip such variants. Probe each
# variant once when this file is sourced and cache the runtime-usable
# list so jose_supports_alg reflects runtime policy without repeated key
# generation.
#
# The variant list is single-sourced from src/kem_alg.h -- the same
# defines the C side and the build-configured scripts follow -- so a
# variant added there is picked up here without updating a literal.
KEM_H="$(dirname -- "$0")/../src/kem_alg.h"
KEM_ALGS="$(sed -n 's/^#define[[:space:]]*KEM_ALG_[0-9]*[[:space:]]*"\([^"]*\)".*/\1/p' "${KEM_H}" | tr '\n' ' ')"

JOSE_RUNTIME_KEM_ALGS=""
for _alg in ${KEM_ALGS}; do
    jose alg 2>/dev/null | grep -Fqx -- "${_alg}" || continue
    if jose jwk gen -i "{\"alg\":\"${_alg}\"}" -o /dev/null >/dev/null 2>&1; then
        JOSE_RUNTIME_KEM_ALGS="${JOSE_RUNTIME_KEM_ALGS} ${_alg}"
    fi
done
unset _alg

# True when the installed jose supports the given algorithm at runtime.
# ML-KEM variants are checked against the cached runtime-usable list
# (see above); other algorithms use the cheap listing check.
jose_supports_alg () {
    case " ${JOSE_RUNTIME_KEM_ALGS} " in
        *" ${1} "*) return 0 ;;
    esac
    case "${1}" in
        ML-KEM-*) return 1 ;;
    esac
    jose alg 2>/dev/null | grep -Fqx -- "${1}"
}

# True when jose supports any ML-KEM variant at runtime.
any_jose_kem_alg () {
    for _alg in ${KEM_ALGS}; do
        jose_supports_alg "${_alg}" && return 0
    done
    return 1
}

# True when the tangd build under test has PQC support. meson exports
# TANG_HAS_PQC from the configure-time probe (see tests/meson.build);
# without it (e.g. a manual run), fall back to the jose runtime probe,
# which matches the build unless PQC was explicitly disabled.
build_has_pqc () {
    if [ -n "${TANG_HAS_PQC+x}" ]; then
        [ "${TANG_HAS_PQC}" = "1" ]
        return
    fi
    any_jose_kem_alg
}

# Hybrid KEM protocol constants, single-sourced from src/pqc.h so the
# shell tests cannot drift from the implementation.
PQC_H="$(dirname -- "$0")/../src/pqc.h"
KEM_VERSION="$(sed -n 's/^#define[[:space:]]*KEM_VERSION[[:space:]]*"\([^"]*\)".*/\1/p' "${PQC_H}")"
ECMR_ALG="$(sed -n 's/^#define[[:space:]]*ECMR_ALG[[:space:]]*"\([^"]*\)".*/\1/p' "${PQC_H}")"
DIR_REQUEST="$(sed -n 's/^#define[[:space:]]*DIR_REQUEST[[:space:]]*"\([^"]*\)".*/\1/p' "${PQC_H}")"
DIR_RESPONSE="$(sed -n 's/^#define[[:space:]]*DIR_RESPONSE[[:space:]]*"\([^"]*\)".*/\1/p' "${PQC_H}")"
