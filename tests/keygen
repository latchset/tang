. helpers

trap 'on_exit' EXIT
TMP=$(mktemp -d)
export TMP
mkdir -p "${TMP}/db"

# Hybrid exchange keys handled by tangd-keygen. They pair with the
# classical ECMR key to form the hybrid key set. The variant list is
# single-sourced from src/kem_alg.h (see tests/helpers).
count_alg_keys () {
    _n=0
    for _f in "${1}"/*.jwk; do
        [ -f "${_f}" ] || continue
        # Whitespace-insensitive: the JWK may be pretty-printed.
        if jose fmt -j "${_f}" -Og alg -Sq "${2}" -E >/dev/null 2>&1; then
            _n=$((_n + 1))
        fi
    done
    printf '%s\n' "${_n}"
}

check_hybrid_keys () {
    _dir="${1}"
    for alg in ${KEM_ALGS}; do
        n=$(count_alg_keys "${_dir}" "${alg}")
        if jose_supports_alg "${alg}"; then
            [ "${n}" -eq 1 ]
        else
            [ "${n}" -eq 0 ]
        fi
    done
}

# Basic generation with explicit file names.
tangd-keygen "${TMP}/db" sig exc
[ -r "${TMP}/db/sig.jwk" ]
[ -r "${TMP}/db/exc.jwk" ]
valid_key_perm "${TMP}/db/sig.jwk"
valid_key_perm "${TMP}/db/exc.jwk"

jose fmt --json "${TMP}/db/sig.jwk" -Og alg -Sq ES512 -E
jose fmt --json "${TMP}/db/exc.jwk" -Og alg -Sq ECMR -E

# Hybrid keys: one key per supported ML-KEM algorithm, none for the
# unsupported ones, all with proper permissions.
check_hybrid_keys "${TMP}/db"
for f in "${TMP}/db"/*.jwk; do
    valid_key_perm "${f}"
done

# Re-running tangd-keygen must not duplicate ML-KEM keys. Classical keys
# are regenerated (they get new thumbprints), ML-KEM keys are skipped as
# one key of each algorithm already exists.
tangd-keygen "${TMP}/db"
check_hybrid_keys "${TMP}/db"
for f in "${TMP}/db"/*.jwk; do
    valid_key_perm "${f}"
done

# A pretty-printed JWK ("alg": "..." with spaces) must still be
# recognized as an existing key of that algorithm: tangd loads and
# advertises it, so tangd-keygen must not create a duplicate.
for f in "${TMP}/db"/*.jwk; do
    alg=$(jose fmt -j "${f}" -Og alg -u- 2>/dev/null) || continue
    case "${alg}" in
    ML-KEM-*) sed -i 's/:/: /g' "${f}" ;;
    esac
done
tangd-keygen "${TMP}/db"
check_hybrid_keys "${TMP}/db"

# The generated ML-KEM keys must be valid JWKs usable for key derivation.
for f in "${TMP}/db"/*.jwk; do
    alg=$(jose fmt --json "${f}" -Og alg -u-)
    case "${alg}" in
    ML-KEM-*)
        jose fmt --json "${f}" -Og kty -Sq AKP -E
        jose jwk use -i "${f}" -r -u deriveKey -o /dev/null
        ;;
    esac
done

echo "tangd-keygen hybrid key generation test passed" >&2
