. helpers

trap 'on_exit' EXIT
export TMP=`mktemp -d`
mkdir -p $TMP/db

rec_startup () {
    # Generate the server keys
    tangd-keygen $TMP/db sig exc
    # Make sure keys generated by tangd-keygen have proper permissions.
    valid_key_perm "${TMP}/db/sig.jwk"
    valid_key_perm "${TMP}/db/exc.jwk"

    # Generate the client keys
    exc_kid=`jose jwk thp -i $TMP/db/exc.jwk`
    tmp=`jose fmt -j $TMP/db/exc.jwk -Od x -d y -d d -o-`
    jose jwk gen -i "$tmp" -o $TMP/exc.jwk
    jose jwk pub -i $TMP/exc.jwk -o $TMP/exc.pub.jwk
}

jose_supports_mlkem () {
    jose alg 2>/dev/null | grep -q "ML-KEM"
}

rec_second_phase () {
    # Make sure that GET fails
    curl -sf http://127.0.0.1:$PORT/rec && expected_fail
    curl -sf http://127.0.0.1:$PORT/rec/ && expected_fail

    # Make a recovery request (NOTE: this is insecure! Don't do this in real code!)
    good=`jose jwk exc -i '{"alg":"ECMR","key_ops":["deriveKey"]}' -l $TMP/exc.jwk -r $TMP/db/exc.jwk`
    full_resp=`curl -sf -X POST \
           -H "Content-Type: application/jwk+json" \
           --data-binary @- \
           http://127.0.0.1:$PORT/rec/${exc_kid} < $TMP/exc.pub.jwk`

    # Strip tang_pub from response and verify the exchange result
    test=`printf '%s' "$full_resp" | jose fmt -j- -Od tang_pub -o-`
    [ "$good" = "$test" ]

    # Verify tang_pub is present and contains no private material
    printf '%s' "$full_resp" | jose fmt -j- -Og tang_pub -o- > $TMP/tang_pub.jwk
    ! jose fmt -j $TMP/tang_pub.jwk -Og d 2>/dev/null

    # Verify tang_pub thumbprint matches the requested key identifier
    [ "$(jose jwk thp -i $TMP/tang_pub.jwk)" = "$exc_kid" ]

    rec_kem_test ""
}

rec_second_phase_endpoint () {
    # Make sure that GET fails
    curl -sf http://127.0.0.1:$PORT/$ENDPOINT/rec && expected_fail
    curl -sf http://127.0.0.1:$PORT/$ENDPOINT/rec/ && expected_fail

    # Make a recovery request (NOTE: this is insecure! Don't do this in real code!)
    good=`jose jwk exc -i '{"alg":"ECMR","key_ops":["deriveKey"]}' -l $TMP/exc.jwk -r $TMP/db/exc.jwk`
    full_resp=`curl -sf -X POST \
           -H "Content-Type: application/jwk+json" \
           --data-binary @- \
           http://127.0.0.1:$PORT/$ENDPOINT/rec/${exc_kid} < $TMP/exc.pub.jwk`

    # Strip tang_pub from response and verify the exchange result
    test=`printf '%s' "$full_resp" | jose fmt -j- -Od tang_pub -o-`
    [ "$good" = "$test" ]

    # Verify tang_pub is present and contains no private material
    printf '%s' "$full_resp" | jose fmt -j- -Og tang_pub -o- > $TMP/tang_pub.jwk
    ! jose fmt -j $TMP/tang_pub.jwk -Og d 2>/dev/null

    # Verify tang_pub thumbprint matches the requested key identifier
    [ "$(jose jwk thp -i $TMP/tang_pub.jwk)" = "$exc_kid" ]

    rec_kem_test "${ENDPOINT}/"
}

rec_kem_test () {
    prefix="${1}"

    if ! jose_supports_mlkem; then
        echo "jose does not support ML-KEM, skipping /rec-kem tests" >&2
        return 0
    fi

    # Find the ML-KEM key in the server db
    kem_jwk=""
    for f in "$TMP"/db/*.jwk; do
        kty=$(jose fmt -j "$f" -Og kty -u- 2>/dev/null) || continue
        if [ "$kty" = "AKP" ]; then
            kem_jwk="$f"
            break
        fi
    done
    if [ -z "$kem_jwk" ]; then
        echo "No ML-KEM key found in server db, skipping /rec-kem tests" >&2
        return 0
    fi

    kem_kid=$(jose jwk thp -i "$kem_jwk" -a S256)
    jose jwk pub -i "$kem_jwk" -o "$TMP/kem.pub.jwk"

    # Step 1: Simulate the stored KEM binding (client encapsulates at bind time)
    stored_encap=$(jose jwk encap -i "$TMP/kem.pub.jwk")
    client_ss=$(printf '%s' "$stored_encap" | jose fmt -j- -Og ss -o-)
    kem_ct=$(printf '%s' "$stored_encap" | jose fmt -j- -Og ct -u-)

    # Step 2: Generate client ephemeral KEM keypair for return channel
    jose jwk gen -i '{"alg":"ML-KEM-768"}' -o "$TMP/clevis_kem.jwk"
    jose jwk pub -i "$TMP/clevis_kem.jwk" -o "$TMP/clevis_kem.pub.jwk"

    # Step 3: Forward channel — encapsulate to tang's KEM pub
    fwd_encap=$(jose jwk encap -i "$TMP/kem.pub.jwk")
    transport_ct=$(printf '%s' "$fwd_encap" | jose fmt -j- -Og ct -u-)
    printf '%s' "$fwd_encap" | jose fmt -j- -Og ss -o- > "$TMP/fwd_ss.jwk"

    # Step 4: Build inner payload {kem_ct, clevis_kem_pub}
    clevis_kem_pub=$(cat "$TMP/clevis_kem.pub.jwk")
    printf '{"kem_ct":"%s","clevis_kem_pub":%s}' "$kem_ct" "$clevis_kem_pub" \
        > "$TMP/inner_payload.json"

    # Step 5: Encrypt inner payload under forward shared secret → encrypted_blob
    encrypted_blob=$(jose jwe enc \
        -i '{"protected":{"alg":"dir","enc":"A256GCM"}}' \
        -I "$TMP/inner_payload.json" \
        -k "$TMP/fwd_ss.jwk" -c)

    # Step 6: POST {encrypted_blob, transport_ct} to /rec-kem
    req_body=$(printf '{"encrypted_blob":"%s","transport_ct":"%s"}' \
        "$encrypted_blob" "$transport_ct")
    server_resp=$(curl -sf -X POST \
        -H "Content-Type: application/json" \
        -d "$req_body" \
        "http://127.0.0.1:$PORT/${prefix}rec-kem/${kem_kid}")

    # Step 7: Parse response {encrypted_key, transport_ct}
    resp_transport_ct=$(printf '%s' "$server_resp" | jose fmt -j- -Og transport_ct -u-)
    resp_encrypted_key=$(printf '%s' "$server_resp" | jose fmt -j- -Og encrypted_key -u-)

    # Step 8: Decapsulate return channel with client KEM private key
    ret_ss=$(jose jwk decap -i "$TMP/clevis_kem.jwk" -c "$resp_transport_ct")
    printf '%s' "$ret_ss" > "$TMP/ret_ss.jwk"

    # Step 9: Split compact JWE into JSON and decrypt enc_kem_key
    IFS='.' read -r prot ekey iv ct tag <<EOF
$resp_encrypted_key
EOF
    printf '{"protected":"%s","encrypted_key":"%s","iv":"%s","ciphertext":"%s","tag":"%s"}' \
        "$prot" "$ekey" "$iv" "$ct" "$tag" > "$TMP/resp_jwe.json"
    recovered_ss=$(jose jwe dec -i "$TMP/resp_jwe.json" -k "$TMP/ret_ss.jwk")

    # Step 10: Verify recovered shared secret matches the original
    client_ss_k=$(printf '%s' "$client_ss" | jose fmt -j- -Og k -u-)
    recovered_ss_k=$(printf '%s' "$recovered_ss" | jose fmt -j- -Og k -u-)
    [ "$client_ss_k" = "$recovered_ss_k" ]

    # Error cases
    curl -sf "http://127.0.0.1:$PORT/${prefix}rec-kem/${kem_kid}" && expected_fail

    code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
        -d "not-json" \
        "http://127.0.0.1:$PORT/${prefix}rec-kem/${kem_kid}")
    [ "$code" = "400" ]

    code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
        -d '{"foo":"bar"}' \
        "http://127.0.0.1:$PORT/${prefix}rec-kem/${kem_kid}")
    [ "$code" = "400" ]

    code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
        -d "$req_body" \
        "http://127.0.0.1:$PORT/${prefix}rec-kem/nonexistent")
    [ "$code" = "404" ]

    code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
        -d "$req_body" \
        "http://127.0.0.1:$PORT/${prefix}rec-kem/${exc_kid}")
    [ "$code" = "403" ]
}
