static void
test_rec_kem_secure_wrong_digest(void)
{
    json_auto_t *priv = NULL;

    if (!jose_jwk_gen(NULL,
            (priv = json_pack("{s:s}", "alg", "ML-KEM-768")))) {
        fprintf(stderr,
                "No ML-KEM support, skipping rec_kem_secure tests\n");
        return;
    }

    __attribute__((cleanup(cleanup_str))) char *tmpdir = copy_fixture();
    ASSERT(tmpdir);
    __attribute__((cleanup(cleanup_tang_keys_info)))
        struct tang_keys_info *tki = read_keys(tmpdir);
    ASSERT(tki);
    __attribute__((cleanup(cleanup_str))) char *ecmr_kid =
        find_key_thp_by_alg(tki, ECMR_ALG);
    ASSERT(ecmr_kid);

    json_auto_t *pub = json_deep_copy(priv);
    jose_jwk_pub(NULL, pub);

    json_auto_t *stored_enc = jose_jwk_kem_enc(NULL, pub);
    ASSERT(stored_enc);
    const char *clevis_kem_ct = json_string_value(
        json_object_get(stored_enc, "ct"));

    json_auto_t *fwd_enc = jose_jwk_kem_enc(NULL, pub);
    ASSERT(fwd_enc);
    const char *fwd_ct = json_string_value(json_object_get(fwd_enc, "ct"));
    json_t *fwd_ss = json_object_get(fwd_enc, "ss");
    ASSERT(fwd_ct && fwd_ss);

    json_auto_t *clevis_kem_priv = json_pack("{s:s}", "alg", "ML-KEM-768");
    ASSERT(jose_jwk_gen(NULL, clevis_kem_priv));
    json_auto_t *clevis_kem_pub = json_deep_copy(clevis_kem_priv);
    jose_jwk_pub(NULL, clevis_kem_pub);

    const char *kem_kid = "test-kem-kid";

    json_auto_t *inner = json_pack("{s:s, s:O, s:s}",
        "clevis_kem_ct", clevis_kem_ct,
        "clevis_kem_pub", clevis_kem_pub,
        "ek_digest", "WRONG_DIGEST_VALUE");

    __attribute__((cleanup(str_cleanup))) char *inner_str =
        json_dumps(inner, JSON_COMPACT);
    ASSERT(inner_str);

    json_auto_t *jwe_hdr = build_enriched_header(ecmr_kid, kem_kid,
                                                    "ML-KEM-768");
    ASSERT(jwe_hdr);
    ASSERT(jose_jwe_enc(NULL, jwe_hdr, NULL, fwd_ss,
                        inner_str, strlen(inner_str)));

    __attribute__((cleanup(str_cleanup))) char *blob = jwe_to_compact(jwe_hdr);
    ASSERT(blob);

    char *out = NULL;
    json_auto_t *req = json_pack("{s:s, s:s}",
        "clevis_encrypted_blob", blob,
        "clevis_transport_ct", fwd_ct);
    ASSERT(rec_kem_secure(priv, tki, kem_kid, req, &out)
           == HTTP_STATUS_BAD_REQUEST);
    ASSERT(out == NULL);

    /* A digest of the right length but wrong content must also be
     * rejected: it exercises the constant-time comparison path. */
    size_t dlen = jose_jwk_thp_buf(NULL, NULL, "S256", NULL, 0);
    ASSERT(dlen != SIZE_MAX);
    size_t elen = jose_b64_enc_buf(NULL, dlen, NULL, 0);
    ASSERT(elen != SIZE_MAX);
    char bad_digest[elen + 1];
    memset(bad_digest, 'A', elen);
    bad_digest[elen] = '\0';

    json_auto_t *inner2 = json_pack("{s:s, s:O, s:s}",
        "clevis_kem_ct", clevis_kem_ct,
        "clevis_kem_pub", clevis_kem_pub,
        "ek_digest", bad_digest);

    __attribute__((cleanup(str_cleanup))) char *inner2_str =
        json_dumps(inner2, JSON_COMPACT);
    ASSERT(inner2_str);

    json_auto_t *jwe_hdr2 = build_enriched_header(ecmr_kid, kem_kid,
                                                     "ML-KEM-768");
    ASSERT(jwe_hdr2);
    ASSERT(jose_jwe_enc(NULL, jwe_hdr2, NULL, fwd_ss,
                        inner2_str, strlen(inner2_str)));

    __attribute__((cleanup(str_cleanup))) char *blob2 =
        jwe_to_compact(jwe_hdr2);
    ASSERT(blob2);

    json_auto_t *req2 = json_pack("{s:s, s:s}",
        "clevis_encrypted_blob", blob2,
        "clevis_transport_ct", fwd_ct);
    ASSERT(rec_kem_secure(priv, tki, kem_kid, req2, &out)
           == HTTP_STATUS_BAD_REQUEST);
    ASSERT(out == NULL);

    remove_tempdir(tmpdir);
}

/* A suite declaring a stronger ML-KEM variant than the algorithm of the
 * KEM key selected through the path must be rejected (anti-downgrade). */
static void
test_rec_kem_secure_suite_mismatch(void)
{
    json_auto_t *priv = NULL;

    if (!jose_jwk_gen(NULL,
            (priv = json_pack("{s:s}", "alg", "ML-KEM-768")))) {
        fprintf(stderr,
                "No ML-KEM support, skipping rec_kem_secure tests\n");
        return;
    }

    __attribute__((cleanup(cleanup_str))) char *tmpdir = copy_fixture();
    ASSERT(tmpdir);
    __attribute__((cleanup(cleanup_tang_keys_info)))
        struct tang_keys_info *tki = read_keys(tmpdir);
    ASSERT(tki);
    __attribute__((cleanup(cleanup_str))) char *ecmr_kid =
        find_key_thp_by_alg(tki, ECMR_ALG);
    ASSERT(ecmr_kid);

    __attribute__((cleanup(str_cleanup))) char *req =
        build_rec_kem_request(priv, ecmr_kid, "test-kem-kid",
                              "ML-KEM-1024", "ML-KEM-768");
    if (!req) {
        fprintf(stderr,
                "No ML-KEM-1024 support, skipping suite mismatch test\n");
        remove_tempdir(tmpdir);
        return;
    }

    char *out = NULL;
    json_auto_t *req_json = json_loads(req, 0, NULL);
    ASSERT(req_json);
    ASSERT(rec_kem_secure(priv, tki, "test-kem-kid", req_json, &out)
           == HTTP_STATUS_BAD_REQUEST);
    ASSERT(out == NULL);

    remove_tempdir(tmpdir);
}

