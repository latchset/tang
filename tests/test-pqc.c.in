/* An oversized protected header must be rejected before any large
 * allocation: the header is attacker-controlled input on an
 * unauthenticated endpoint. */
static void
test_rec_kem_secure_oversized_protected_header(void)
{
    json_auto_t *priv = NULL;

    if (!jose_jwk_gen(NULL,
            (priv = json_pack("{s:s}", "alg", "ML-KEM-768")))) {
        fprintf(stderr,
                "No ML-KEM support, skipping rec_kem_secure tests\n");
        return;
    }

    __attribute__((cleanup(cleanup_str))) char *tmpdir = copy_fixture();
    ASSERT(tmpdir);
    __attribute__((cleanup(cleanup_tang_keys_info)))
        struct tang_keys_info *tki = read_keys(tmpdir);
    ASSERT(tki);
    __attribute__((cleanup(cleanup_str))) char *ecmr_kid =
        find_key_thp_by_alg(tki, ECMR_ALG);
    ASSERT(ecmr_kid);

    json_auto_t *pub = json_deep_copy(priv);
    jose_jwk_pub(NULL, pub);

    json_auto_t *fwd_enc = jose_jwk_kem_enc(NULL, pub);
    ASSERT(fwd_enc);
    const char *fwd_ct = json_string_value(json_object_get(fwd_enc, "ct"));
    json_t *fwd_ss = json_object_get(fwd_enc, "ss");
    ASSERT(fwd_ct && fwd_ss);

    json_auto_t *jwe_hdr = build_enriched_header(ecmr_kid, "test-kem-kid",
                                                 "ML-KEM-768");
    ASSERT(jwe_hdr);
    json_t *protected = json_object_get(jwe_hdr, "protected");
    ASSERT(protected);

    /* Pad the protected header past the accepted maximum. */
    char *pad = malloc(MAX_PROTECTED_HEADER_LEN + 1);
    ASSERT(pad);
    memset(pad, 'A', MAX_PROTECTED_HEADER_LEN);
    pad[MAX_PROTECTED_HEADER_LEN] = '\0';
    int set = json_object_set_new(protected, "pad", json_string(pad));
    free(pad);
    ASSERT(set == 0);

    const char *payload = "{}";
    ASSERT(jose_jwe_enc(NULL, jwe_hdr, NULL, fwd_ss,
                        payload, strlen(payload)));

    __attribute__((cleanup(str_cleanup))) char *blob = jwe_to_compact(jwe_hdr);
    ASSERT(blob);

    char *out = NULL;
    json_auto_t *req = json_pack("{s:s, s:s}",
        "clevis_encrypted_blob", blob,
        "clevis_transport_ct", fwd_ct);
    ASSERT(rec_kem_secure(priv, tki, "test-kem-kid", req, &out)
           == HTTP_STATUS_BAD_REQUEST);
    ASSERT(out == NULL);

    remove_tempdir(tmpdir);
}

static void
test_rec_kem_secure_success(void)
{
    json_auto_t *priv = NULL;

    if (!jose_jwk_gen(NULL,
            (priv = json_pack("{s:s}", "alg", "ML-KEM-768")))) {
        fprintf(stderr,
                "No ML-KEM support, skipping rec_kem_secure tests\n");
        return;
    }

    json_auto_t *pub = json_deep_copy(priv);
    jose_jwk_pub(NULL, pub);

    json_auto_t *stored_enc = jose_jwk_kem_enc(NULL, pub);
    ASSERT(stored_enc);
    json_t *enc_key = json_object_get(stored_enc, "ss");
    const char *clevis_kem_ct = json_string_value(
        json_object_get(stored_enc, "ct"));
    ASSERT(enc_key && clevis_kem_ct);

    size_t dlen = jose_jwk_thp_buf(NULL, NULL, "S256", NULL, 0);
    ASSERT(dlen != SIZE_MAX);
    size_t elen = jose_b64_enc_buf(NULL, dlen, NULL, 0);
    ASSERT(elen != SIZE_MAX);
    uint8_t hash_buf[dlen];
    char thp_buf[elen + 1];
    ASSERT(jose_jwk_thp_buf(NULL, enc_key, "S256", hash_buf, dlen));
    ASSERT(jose_b64_enc_buf(hash_buf, dlen, thp_buf, elen) == elen);
    thp_buf[elen] = '\0';

    json_auto_t *fwd_enc = jose_jwk_kem_enc(NULL, pub);
    ASSERT(fwd_enc);
    const char *fwd_ct = json_string_value(json_object_get(fwd_enc, "ct"));
    json_t *fwd_ss = json_object_get(fwd_enc, "ss");
    ASSERT(fwd_ct && fwd_ss);

    json_auto_t *clevis_kem_priv = json_pack("{s:s}", "alg", "ML-KEM-768");
    ASSERT(jose_jwk_gen(NULL, clevis_kem_priv));
    json_auto_t *clevis_kem_pub = json_deep_copy(clevis_kem_priv);
    jose_jwk_pub(NULL, clevis_kem_pub);

    __attribute__((cleanup(cleanup_str))) char *tmpdir = copy_fixture();
    ASSERT(tmpdir);
    __attribute__((cleanup(cleanup_tang_keys_info)))
        struct tang_keys_info *tki = read_keys(tmpdir);
    ASSERT(tki);
    __attribute__((cleanup(cleanup_str))) char *ecmr_kid =
        find_key_thp_by_alg(tki, ECMR_ALG);
    ASSERT(ecmr_kid);

    const char *kem_kid = "test-kem-kid";

    json_auto_t *inner = json_pack("{s:s, s:O, s:s}",
        "clevis_kem_ct", clevis_kem_ct,
        "clevis_kem_pub", clevis_kem_pub,
        "ek_digest", thp_buf);

    __attribute__((cleanup(str_cleanup))) char *inner_str =
        json_dumps(inner, JSON_COMPACT);
    ASSERT(inner_str);

    json_auto_t *jwe_hdr = build_enriched_header(ecmr_kid, kem_kid,
                                                    "ML-KEM-768");
    ASSERT(jwe_hdr);
    ASSERT(jose_jwe_enc(NULL, jwe_hdr, NULL, fwd_ss,
                        inner_str, strlen(inner_str)));

    __attribute__((cleanup(str_cleanup))) char *blob = jwe_to_compact(jwe_hdr);
    ASSERT(blob);

    char *out = NULL;
    json_auto_t *req = json_pack("{s:s, s:s}",
        "clevis_encrypted_blob", blob,
        "clevis_transport_ct", fwd_ct);
    int status = rec_kem_secure(priv, tki, kem_kid, req, &out);
    ASSERT_WITH_MSG(status == HTTP_STATUS_OK,
                    "expected 200, got %d", status);
    ASSERT(out);

    json_auto_t *resp = json_loads(out, 0, NULL);
    free(out);
    ASSERT(resp);
    const char *tang_encrypted_key = json_string_value(
        json_object_get(resp, "tang_encrypted_key"));
    const char *tang_transport_ct = json_string_value(
        json_object_get(resp, "tang_transport_ct"));
    ASSERT(tang_encrypted_key);
    ASSERT(tang_transport_ct);

    json_auto_t *tang_ct_json = json_string(tang_transport_ct);
    json_auto_t *tang_ss = jose_jwk_kem_dec(NULL,
        clevis_kem_priv, tang_ct_json);
    ASSERT(tang_ss);

    json_auto_t *resp_jwe = jwe_from_compact(tang_encrypted_key);
    ASSERT(resp_jwe);

    size_t ptl = 0;
    void *pt = jose_jwe_dec(NULL, resp_jwe, NULL, tang_ss, &ptl);
    ASSERT(pt);

    json_auto_t *recovered = json_loadb(pt, ptl, 0, NULL);
    OPENSSL_clear_free(pt, ptl);
    ASSERT(recovered);

    const char *orig_k = json_string_value(
        json_object_get(enc_key, "k"));
    const char *recov_k = json_string_value(
        json_object_get(recovered, "k"));
    ASSERT(orig_k && recov_k);
    ASSERT(strcmp(orig_k, recov_k) == 0);

    /* Validate response enriched protected header */
    const char *resp_prot_b64 = json_string_value(
        json_object_get(resp_jwe, "protected"));
    ASSERT(resp_prot_b64);

    size_t dec_len = jose_b64_dec_buf(
        resp_prot_b64, strlen(resp_prot_b64), NULL, 0);
    ASSERT(dec_len != SIZE_MAX);
    uint8_t dec_buf[dec_len + 1];
    ASSERT(jose_b64_dec_buf(resp_prot_b64, strlen(resp_prot_b64),
                            dec_buf, dec_len) == dec_len);
    dec_buf[dec_len] = '\0';

    json_auto_t *resp_hdr = json_loads((char *)dec_buf, 0, NULL);
    ASSERT(resp_hdr);

    ASSERT(strcmp(json_string_value(
        json_object_get(resp_hdr, "kem_ver")), KEM_VERSION) == 0);
    ASSERT(strcmp(json_string_value(
        json_object_get(resp_hdr, "suite")), "ECMR+ML-KEM-768") == 0);
    ASSERT(strcmp(json_string_value(
        json_object_get(resp_hdr, "kid")), ecmr_kid) == 0);
    ASSERT(strcmp(json_string_value(
        json_object_get(resp_hdr, "kem_kid")), kem_kid) == 0);
    ASSERT(strcmp(json_string_value(
        json_object_get(resp_hdr, "msg_dir")), DIR_RESPONSE) == 0);

    /* req_digest must not be reintroduced in the response header. */
    ASSERT(json_object_get(resp_hdr, "req_digest") == NULL);

    /* crit must list exactly the extension parameters; kid is a
     * standard JOSE header (RFC 7515 section 4.1.4) and is never
     * crit'd. */
    json_t *crit = json_object_get(resp_hdr, "crit");
    ASSERT(crit && json_is_array(crit));
    ASSERT(json_array_size(crit) == 4);
    const char *expected_crit[] = {"kem_ver", "suite", "kem_kid",
                                   "msg_dir"};
    for (size_t i = 0; i < ARRAY_COUNT(expected_crit); i++) {
        const char *member = json_string_value(json_array_get(crit, i));
        ASSERT(member);
        ASSERT(strcmp(member, expected_crit[i]) == 0);
    }

    /* No extra members beyond alg, enc, crit and the crit'd ones. */
    ASSERT(json_object_size(resp_hdr) == 8);

    remove_tempdir(tmpdir);
}

static void
test_pqc_is_available(void)
{
    ASSERT(pqc_is_available() == 1);
}

static void
run_tests(void)
{
    test_jwe_from_compact_valid();
    test_jwe_from_compact_invalid();
    test_jwe_roundtrip();
    test_jwe_to_compact_missing_fields();

    test_parse_query_alg_basic();
    test_parse_query_alg_with_extra_params();
    test_parse_query_alg_edge_cases();

    test_is_valid_alg_param();

    test_wipe_jwk_secret_null_safety();
    test_wipe_jwk_secret_wipes();
    test_wipe_and_release_null_safety();
    test_wipe_and_release();

    test_find_jws_kem_null_tki();
    test_find_jws_kem_filtering();
    test_find_jws_kem_empty_payload();
    test_find_jws_kem_by_thp_null();
    test_find_jws_kem_by_thp_lookup();
    test_find_jws_kem_by_thp_rejects_non_kem();

    test_validate_request_protected();

    test_rec_kem_secure_bad_json();
    test_rec_kem_secure_bad_transport_ct();
    test_rec_kem_secure_bad_blob();
    test_rec_kem_secure_bad_inner_payload();
    test_rec_kem_secure_wrong_digest();
    test_rec_kem_secure_suite_mismatch();
    test_rec_kem_secure_unknown_ecmr_kid();
    test_rec_kem_secure_clevis_alg_mismatch();
    test_rec_kem_secure_oversized_protected_header();
    test_rec_kem_secure_success();

    test_pqc_is_available();
}

int main(int argc, char** argv)
{
    run_tests();
    return 0;
}
