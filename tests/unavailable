. helpers

trap 'on_exit' EXIT
export TMP=$(mktemp -d)
mkdir -p "${TMP}/db"

# Server binary under test: a PQC build whose jose_jwk_gen is wrapped
# to fail, so the runtime ML-KEM probe reports unavailable. Only built
# when the build itself has PQC support.
TANGD_BIN=tangd-unavailable
command -v "${TANGD_BIN}" >/dev/null 2>&1 || {
    echo "${TANGD_BIN} not found" >&2
    exit 77
}

# A complete key store, including real ML-KEM keys when jose supports
# them, so hybrid_recovery:false is attributable to the runtime probe
# alone and not to an empty key store.
tangd-keygen "${TMP}/db" sig exc
valid_key_perm "${TMP}/db/sig.jwk"

PORT=$(random_port)
export PORT
"${TANGD_BIN}" -p "${PORT}" -l "${TMP}/db" 2>"${TMP}/stderr" &
export PID=$!
wait_for_port "${PORT}"

# Classical advertisement is unaffected by the runtime probe failure.
fetch /adv | ver "${TMP}/db/sig.jwk"

# /version must not advertise hybrid recovery, even though complete
# AKP keys exist in the key store: the runtime probe fails.
ver_resp=$(fetch /version)
hybrid=$(printf '%s' "${ver_resp}" \
    | jose fmt -j- -Og features -Og hybrid_recovery -o-)
[ "${hybrid}" = "false" ]

# The hybrid KEM endpoints are hidden with a uniform 404, whether or
# not ML-KEM keys exist in the key store.
kem_jwk=$(find "${TMP}/db" -maxdepth 1 -name '*.jwk' ! -name '.*' \
    -exec grep -l '"kty":"AKP"' {} + 2>/dev/null | head -n 1 || true)
if [ -n "${kem_jwk}" ]; then
    kem_thp=$(jose jwk thp -i "${kem_jwk}")
else
    kem_thp="dummythp0123456789"
fi

code=$(curl -s -o /dev/null -w "%{http_code}" \
    "http://127.0.0.1:${PORT}/adv-kem?alg=ML-KEM-768")
[ "${code}" = "404" ]

code=$(curl -s -o /dev/null -w "%{http_code}" \
    "http://127.0.0.1:${PORT}/adv-kem/${kem_thp}")
[ "${code}" = "404" ]

code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
    -H "Content-Type: application/json" \
    -d '{"clevis_encrypted_blob":"a","clevis_transport_ct":"b"}' \
    "http://127.0.0.1:${PORT}/rec-kem/${kem_thp}")
[ "${code}" = "404" ]

# A wrong HTTP method must also answer 404, not 405, so the existence
# of the hidden endpoints is not leaked.
code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
    "http://127.0.0.1:${PORT}/adv-kem?alg=ML-KEM-768")
[ "${code}" = "404" ]

code=$(curl -s -o /dev/null -w "%{http_code}" \
    "http://127.0.0.1:${PORT}/rec-kem/${kem_thp}")
[ "${code}" = "404" ]

# A runtime-unavailable PQC build must say so in the logs, exactly
# once, so it is distinguishable from a legitimate no-PQC build.
[ "$(grep -c 'ML-KEM is unavailable at runtime' "${TMP}/stderr")" = "1" ]

echo "Runtime-unavailable PQC server test passed" >&2
